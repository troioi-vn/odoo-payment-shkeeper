<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_method_form" model="ir.ui.view">
        <field name="name">SHKeeper Payment Method Form</field>
        <field name="model">payment.method</field>
        <field name="inherit_id" ref="payment.payment_method_form"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="shkeeper_crypto" placeholder="e.g. BTC, USDT"/>
            </field>
        </field>
    </record>

</odoo>

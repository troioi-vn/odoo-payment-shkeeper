<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_shkeeper_btc" model="payment.method">
        <field name="name">Bitcoin</field>
        <field name="code">shkeeper_btc</field>
        <field name="shkeeper_crypto">BTC</field>
        <field name="sequence">1000</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_shkeeper/static/img/btc.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
    </record>

    <record id="payment_method_shkeeper_usdt_trc20" model="payment.method">
        <field name="name">USDT (TRC20)</field>
        <field name="code">shkeeper_usdt_trc20</field>
        <field name="shkeeper_crypto">USDT</field>
        <field name="sequence">1001</field>
        <field name="active">False</field>
        <field name="image" type="base64" file="payment_shkeeper/static/img/usdt.png"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_manual_capture">none</field>
        <field name="support_refund">none</field>
    </record>

</odoo>
